[Unit]
Description=Lantano: logs de nginx o Apache hacia PostgreSQL
After=network-online.target nginx.service apache2.service
Wants=network-online.target

[Service]
Type=simple
User=lantano
WorkingDirectory=/opt/lantano
ExecStart=/opt/lantano/venv/bin/python /opt/lantano/leer_log.py
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
