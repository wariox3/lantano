# Servidor web cuyos logs se leen: nginx o apache
LANTANO_ORIGEN='nginx'

LANTANO_PG_DATABASE_USER='lantano'
LANTANO_PG_DATABASE_CLAVE=''
LANTANO_PG_DATABASE_HOST=''
LANTANO_PG_DATABASE_PORT=''
LANTANO_PG_DATABASE_NAME='bdlantano'
# Nombre de este servidor que se guarda en la columna servidor. Vacío: se guarda NULL.
LANTANO_SERVIDOR=''
# SSL: require cifra la conexión; verify-full además valida el certificado (requiere LANTANO_PG_SSLROOTCERT).
# Usar prefer solo si PostgreSQL no tiene SSL configurado.
LANTANO_PG_SSLMODE='require'
LANTANO_PG_SSLROOTCERT=''

# Opcionales (valores por defecto)
# Vacíos: /var/log/nginx/*access*.log y *error*.log con nginx, /var/log/apache2/... con apache
LANTANO_ACCESS_GLOB=''
LANTANO_ERROR_GLOB=''
LANTANO_LOTE=500
LANTANO_INTERVALO=5
LANTANO_ESCANEO=1
# Expresión regular sobre la URI; las coincidencias no se guardan. Ej: ^/static/|\.(css|js|png|jpg|ico)$
LANTANO_EXCLUIR=''
# Parámetros de la URL cuyo valor se reemplaza por ***. Basta con que el nombre contenga la palabra
# (key oculta api_key, token oculta access_token). Sin distinguir mayúsculas.
LANTANO_PARAMETROS_OCULTOS='token,password,key,secret'
