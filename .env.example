NGINX_PG_DATABASE_USER=''
NGINX_PG_DATABASE_CLAVE=''
NGINX_PG_DATABASE_HOST=''
NGINX_PG_DATABASE_PORT=''
NGINX_PG_DATABASE_NAME=''

# Opcionales (valores por defecto)
NGINX_ACCESS_GLOB='/var/log/nginx/*access*.log'
NGINX_ERROR_GLOB='/var/log/nginx/*error*.log'
NGINX_LOTE=500
NGINX_INTERVALO=5
NGINX_ESCANEO=1
# Expresión regular sobre la URI; las coincidencias no se guardan. Ej: ^/static/|\.(css|js|png|jpg|ico)$
NGINX_EXCLUIR=''
# Parámetros de la URL cuyo valor se reemplaza por ***
NGINX_PARAMETROS_OCULTOS='token,password,key,secret'
