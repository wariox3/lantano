NGINX_PG_DATABASE_USER=''
NGINX_PG_DATABASE_CLAVE=''
NGINX_PG_DATABASE_HOST=''
NGINX_PG_DATABASE_PORT=''
NGINX_PG_DATABASE_NAME=''
# Nombre del servidor nginx que se guarda en la columna servidor. Vacío: se guarda NULL.
NGINX_SERVIDOR=''
# SSL: require cifra la conexión; verify-full además valida el certificado (requiere NGINX_PG_SSLROOTCERT).
# Usar prefer solo si PostgreSQL no tiene SSL configurado.
NGINX_PG_SSLMODE='require'
NGINX_PG_SSLROOTCERT=''

# Opcionales (valores por defecto)
NGINX_ACCESS_GLOB='/var/log/nginx/*access*.log'
NGINX_ERROR_GLOB='/var/log/nginx/*error*.log'
NGINX_LOTE=500
NGINX_INTERVALO=5
NGINX_ESCANEO=1
# Expresión regular sobre la URI; las coincidencias no se guardan. Ej: ^/static/|\.(css|js|png|jpg|ico)$
NGINX_EXCLUIR=''
# Parámetros de la URL cuyo valor se reemplaza por ***. Basta con que el nombre contenga la palabra
# (key oculta api_key, token oculta access_token). Sin distinguir mayúsculas.
NGINX_PARAMETROS_OCULTOS='token,password,key,secret'
